    {
      "name": "vertical_wind",
      "role": "negative",
      "expected_terminal_status": "source_latched",
      "required_rejection_reasons": ["innovation_nis", "source_latched"]
    }
  ],
  "acceptance_policy": {
    "positive": [
      "The causal lane must qualify only after sufficient rank-2 causal information is present.",
      "The hidden truth scorer must report terminal wind error within the frozen bound.",
      "The known-wind upper bound must pass analytic versus finite-difference Jacobian agreement and the frozen nominal NIS range."
    ],
    "negative": [
      "Every declared invalid, stale, delayed, or unobservable case must fail closed and must not finish qualified.",
      "Invalid/rejected observations must not add measurement information or change the wind estimate.",
      "GNSS outage must age the qualification; TAS alone must not continue to claim new wind observability."
    ]
  },
  "promotion_blockers": [
    "Freeze separate train/tune/holdout physical air-data datasets with source-time and calibration provenance.",
    "Demonstrate benefit against the frozen 15-error-state baseline under qualified fixed-wing data, including GNSS outages and recovery.",
    "Validate target precision, WCET, stack, memory, source gating, and shadow-flight behavior before a wind-state branch can affect FCOne control."
  ]
}
