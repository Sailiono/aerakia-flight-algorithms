      "role": "negative",
      "expected_terminal_status": "not_observable",
      "required_rejection_reasons": ["flight_regime"]
    },
    {
      "name": "rotor_wash",
      "role": "negative",
      "expected_terminal_status": "not_observable",
      "required_rejection_reasons": ["rotor_wash"]
    },
    {
      "name": "sideslip",
      "role": "negative",
      "expected_terminal_status": "not_observable",
      "required_rejection_reasons": ["sideslip_unqualified"]
    },
    {
      "name": "blocked_pitot",
      "role": "negative",
      "expected_terminal_status": "not_observable",
